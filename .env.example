# Copy to .env and fill in. Never commit .env.
# PostgreSQL connection URL
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/medreminder
# Redis URL for the Celery broker and result backend.
# Use rediss://... for TLS (e.g. Upstash); ssl_cert_reqs=required is added if missing.
REDIS_URL=redis://localhost:6379/0

# Optional
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional reminder tuning (defaults shown; see README)
# NOTIFICATION_CHANNELS=email
# REMINDER_GRACE_MINUTES=60
# DOSE_MISSED_AFTER_MINUTES=120
# DEFAULT_FROM_EMAIL=reminders@medreminder.local
SITE_BASE_URL=http://localhost:8000
# WEEKLY_SUMMARY_LOCAL_HOUR=8
