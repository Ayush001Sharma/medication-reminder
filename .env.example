# Copy this file to ".env" and edit the copy. NEVER commit ".env": it holds real credentials.
# Every value below is a placeholder. Real environment variables override ".env".
# Each variable is explained in the README ("Environment variables").

# ---- Required -----------------------------------------------------------------------------------
# PostgreSQL connection URL. URL-encode special characters in the password (@ -> %40, : -> %3A).
DATABASE_URL=postgres://DB_USER:DB_PASSWORD@localhost:5432/medreminder
# Redis URL for the Celery broker, result backend, and rate-limit counters.
# Local:  redis://localhost:6379/0     Hosted with TLS (e.g. Upstash):  rediss://default:PASSWORD@HOST:6379
# A rediss:// URL without ssl_cert_reqs gets ?ssl_cert_reqs=required added automatically.
REDIS_URL=redis://localhost:6379/0

# ---- Django -------------------------------------------------------------------------------------
# Signs JWTs and one-click dose links. REQUIRED (32+ random characters) whenever DJANGO_DEBUG is not true.
# While DJANGO_DEBUG=true you can leave it unset: a built-in development key is used.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=paste-the-generated-value-here
# "true" for local development only. Must be "false" anywhere reachable by other people.
DJANGO_DEBUG=true
# Comma-separated host names this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public address used to build the one-click link in reminder emails.
SITE_BASE_URL=http://localhost:8000
# Browser origins (your web frontend) allowed to call the API, comma-separated: scheme + host [+ port], no
# path, no wildcard. Empty means no cross-origin browser access. These are the Vite dev and preview servers.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Email --------------------------------------------------------------------------------------
# Default prints emails in the terminal running the Celery worker (development).
# For real delivery use django.core.mail.backends.smtp.EmailBackend and fill in the EMAIL_HOST* values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=reminders@medreminder.local
# Seconds one SMTP send may take (also bounds how long a worker can hold a reminder).
EMAIL_TIMEOUT=30
# SMTP settings, used only with the SMTP backend.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=smtp-username
EMAIL_HOST_PASSWORD=smtp-password-placeholder

# ---- Reminders (defaults shown) -----------------------------------------------------------------
# Comma-separated: email, sms, whatsapp. Only email really sends; sms and whatsapp are log-only stubs.
NOTIFICATION_CHANNELS=email
# Send a reminder this many seconds before the dose time.
REMINDER_LEAD_SECONDS=60
# A pending dose is still reminded up to this many minutes late (covers worker downtime).
REMINDER_GRACE_MINUTES=60
# A sending reminder that is stuck this long (worker died mid-send) is recovered and retried.
REMINDER_SENDING_TIMEOUT_SECONDS=600
# Send attempts before a reminder is recorded as failed, and the first retry delay (doubles each time).
REMINDER_MAX_ATTEMPTS=5
REMINDER_RETRY_BASE_SECONDS=60
# Most reminders claimed in one Beat tick.
REMINDER_BATCH_SIZE=200
# A dose still untaken this many minutes after its time becomes "missed".
DOSE_MISSED_AFTER_MINUTES=120
# Local hour (0-23) on Monday from which each patient's finished week is emailed.
WEEKLY_SUMMARY_LOCAL_HOUR=8

# ---- Rate limits: "<count>/<sec|min|hour|day>" --------------------------------------------------
RATE_LIMIT_LOGIN=10/min
RATE_LIMIT_LOGIN_ACCOUNT=5/min
RATE_LIMIT_REGISTER=20/hour
RATE_LIMIT_INVITE=20/hour
RATE_LIMIT_DOSE_LINK=30/min
# Number of reverse proxies in front of the app (0 = none). Wrong values let clients dodge rate limits.
NUM_PROXIES=0

# ---- Logging ------------------------------------------------------------------------------------
# "plain" is readable; "json" prints one JSON object per line for log tools.
LOG_FORMAT=plain
LOG_LEVEL=INFO

# ---- Demo data (python manage.py seed_demo) -----------------------------------------------------
# Password for the demo accounts. Local development only. Leave unset to use the default in the README.
# DEMO_PASSWORD=choose-a-demo-password
