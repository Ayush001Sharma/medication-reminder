# Copy to ".env.local" (git-ignored). Only variables starting with VITE_ are visible to the browser:
# never put a secret here, everything in this file ends up in the downloadable JavaScript.
#
# Base URL of the backend API, with no trailing slash. This origin must also be listed in the backend's
# CORS_ALLOWED_ORIGINS variable for the browser to be allowed to call it.
VITE_API_BASE_URL=http://localhost:8000

# Demo mode: "true" adds four one-click buttons to the sign-in page ("Try as patient (Kolkata)", "Try as patient
# (New York)", "Try as caregiver", "Try as doctor") that sign in with the accounts created by
# `python manage.py seed_demo`. Any other value, or leaving it out, builds an app WITHOUT demo mode: the buttons
# and the demo password are not in the build at all. LOCAL DEVELOPMENT ONLY: never turn it on for a real backend.
VITE_DEMO_MODE=false

# The seed_demo accounts (see README, "Demo data"). They share one well-known development password: the
# --password option, else DEMO_PASSWORD, else the default below. These are public sample values, not secrets;
# change them only if you seeded with a different password. They are read only when VITE_DEMO_MODE=true.
VITE_DEMO_PASSWORD=demo-password-123
VITE_DEMO_PATIENT_KOLKATA_EMAIL=demo.asha@example.com
VITE_DEMO_PATIENT_NEW_YORK_EMAIL=demo.ben@example.com
VITE_DEMO_CAREGIVER_EMAIL=demo.carla@example.com
VITE_DEMO_DOCTOR_EMAIL=demo.dr.rao@example.com
