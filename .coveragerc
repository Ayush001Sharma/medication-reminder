[run]
source = accounts, medications, scheduling, notifications, reports, config
branch = True
omit =
    */migrations/*
    */tests/*
    */tests.py
    conftest.py
    manage.py
    config/asgi.py
    config/wsgi.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
